APP_ENV=development
POSTGRES_PASSWORD=change-me
# Host-side URLs (Postgres published on 127.0.0.1:5433; 5432 is used by another project on this VPS)
DATABASE_URL=postgresql+psycopg://aircon:change-me@127.0.0.1:5433/aircon
TEST_DATABASE_URL=postgresql+psycopg://aircon:change-me@127.0.0.1:5433/aircon_test
# At least 32 characters or the API refuses to start. Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-chars
JWT_EXPIRE_MINUTES=1440
BUSINESS_TZ=Asia/Yangon
